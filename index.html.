<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#10131c">
<title>STUDY FLOW — 학습 대시보드</title>
<style>
:root{--bg:#0d1018;--panel:#151a26;--panel2:#1b2231;--line:#293246;--text:#edf1fa;--muted:#929db2;--accent:#8ba8ff;--accent2:#b5c5ff;--green:#79d6b0;--orange:#f0bd78;--red:#ff8d9a;--radius:18px;--shadow:0 12px 34px #0003}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 15% -10%,#27345855,transparent 42%),var(--bg);color:var(--text);font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.5}
button,input,select{font:inherit}button{cursor:pointer}.app{max-width:1440px;margin:auto;padding:26px 28px 48px}
header{display:flex;justify-content:space-between;align-items:center;gap:18px;margin-bottom:28px}.brand{display:flex;align-items:center;gap:12px}.logo{width:42px;height:42px;border-radius:14px;background:linear-gradient(135deg,#90aaff,#6379d6);display:grid;place-items:center;color:#10172a;font-weight:900;font-size:19px}.brand h1{font-size:17px;letter-spacing:2px;margin:0}.brand p{margin:2px 0 0;color:var(--muted);font-size:11px;letter-spacing:1.5px}.header-right{display:flex;align-items:center;gap:10px}.date-pill,.btn{border:1px solid var(--line);background:var(--panel);color:var(--text);border-radius:12px;padding:10px 13px}.btn.primary{background:var(--accent);color:#10172a;border-color:transparent;font-weight:750}.btn:hover{filter:brightness(1.12)}.hero{display:flex;justify-content:space-between;align-items:end;gap:20px;margin:10px 0 24px}.eyebrow{color:var(--accent2);font-size:11px;font-weight:800;letter-spacing:2px}.hero h2{font-size:clamp(27px,4vw,39px);letter-spacing:-1.4px;margin:5px 0}.hero p{margin:0;color:var(--muted)}.hero-note{color:var(--muted);font-size:12px;text-align:right}
.grid{display:grid;grid-template-columns:repeat(12,1fr);gap:16px}.card{background:linear-gradient(145deg,#1a2030,#141925);border:1px solid var(--line);border-radius:var(--radius);padding:19px;box-shadow:var(--shadow);min-width:0}.stat{grid-column:span 3}.wide{grid-column:span 8}.side{grid-column:span 4}.full{grid-column:span 12}.half{grid-column:span 6}.card-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:16px}.card h3{font-size:14px;margin:0;font-weight:750}.muted{color:var(--muted)}.stat-label{font-size:12px;color:var(--muted)}.stat-value{font-size:30px;font-weight:800;letter-spacing:-1px;margin:6px 0 2px}.stat-foot{font-size:11px;color:var(--muted)}.stat-icon{float:right;color:var(--accent);font-size:20px}.progress-track{height:8px;background:#2a3347;border-radius:20px;overflow:hidden}.progress-fill{height:100%;background:linear-gradient(90deg,#7898ff,#a4b7ff);border-radius:20px;transition:width .25s}.progress-row{display:flex;justify-content:space-between;font-size:12px;margin:12px 0 7px}.schedule{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:8px}.day{background:#111622;border:1px solid var(--line);border-radius:13px;padding:10px 8px;min-height:145px}.day.today{border-color:var(--accent);background:#202a43}.day-name{text-align:center;font-size:11px;color:var(--muted);margin-bottom:9px}.day.today .day-name{color:var(--accent2);font-weight:800}.event{font-size:10px;padding:6px 7px;border-radius:8px;background:#303d60;color:#dce5ff;margin:5px 0;overflow-wrap:anywhere}.event small{display:block;color:#b4c3ec;font-size:9px}.empty{color:#59657b;text-align:center;font-size:10px;padding-top:26px}.subject{margin:13px 0}.subject-top{display:flex;justify-content:space-between;font-size:12px;margin-bottom:7px}.subject-top strong{font-weight:700}.subject-top span{color:var(--muted)}.subject-actions{display:flex;gap:6px}.mini{border:1px solid var(--line);background:#20283a;color:var(--text);border-radius:8px;padding:5px 8px;font-size:11px}.timer-display{font-size:43px;font-weight:800;letter-spacing:1px;text-align:center;margin:12px 0 4px;font-variant-numeric:tabular-nums}.timer-sub{text-align:center;color:var(--muted);font-size:12px}.timer-controls{display:flex;justify-content:center;gap:8px;margin:17px 0}.field{width:100%;background:#101622;border:1px solid var(--line);color:var(--text);border-radius:10px;padding:10px 11px;outline:none}.field:focus{border-color:var(--accent)}.form-row{display:flex;gap:8px;margin:10px 0}.form-row>*{min-width:0}.form-row .field{flex:1}.table-wrap{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:12px}th,td{text-align:left;padding:10px 8px;border-bottom:1px solid var(--line);white-space:nowrap}th{color:var(--muted);font-weight:600}.tag{font-size:10px;padding:4px 7px;border-radius:7px;background:#293550;color:#bdcbf2}.bar-chart{height:140px;display:flex;align-items:end;gap:clamp(5px,1.5vw,15px);padding:10px 4px 0}.bar-col{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:end;height:100%;gap:6px}.bar{width:min(100%,34px);min-height:2px;background:linear-gradient(180deg,#a9baff,#657edc);border-radius:7px 7px 2px 2px}.bar-label{font-size:10px;color:var(--muted)}.bar-number{font-size:9px;color:var(--muted)}.empty-state{padding:20px;text-align:center;color:var(--muted);font-size:12px}.modal-back{position:fixed;inset:0;background:#0009;display:none;place-items:center;padding:18px;z-index:5}.modal{width:min(460px,100%);background:#171e2c;border:1px solid var(--line);border-radius:18px;padding:22px;box-shadow:var(--shadow)}.modal h3{margin:0 0 14px}.modal-actions{display:flex;justify-content:end;gap:8px;margin-top:16px}.toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%);background:#dce5ff;color:#111a2c;padding:10px 16px;border-radius:10px;font-size:12px;font-weight:700;opacity:0;pointer-events:none;transition:opacity .2s}.toast.show{opacity:1}.footer{text-align:center;color:#667187;font-size:10px;margin-top:22px}
@media(max-width:900px){.stat{grid-column:span 6}.wide,.side{grid-column:span 12}.half{grid-column:span 12}.hero{align-items:start;flex-direction:column}.hero-note{text-align:left}.schedule{gap:5px}.day{padding:8px 4px;min-height:125px}.event{font-size:9px;padding:5px 4px}}
@media(max-width:560px){.app{padding:17px 13px 35px}header{align-items:flex-start}.header-right{flex-direction:column;align-items:flex-end}.date-pill{font-size:10px;padding:7px}.brand h1{font-size:14px}.brand p{font-size:9px}.logo{width:36px;height:36px}.card{padding:15px}.stat-value{font-size:25px}.schedule{grid-template-columns:repeat(7,minmax(0,1fr));gap:3px}.day{min-height:110px;padding:7px 2px}.day-name{font-size:9px}.event{font-size:8px;line-height:1.25}.event small{font-size:8px}.timer-display{font-size:38px}}
</style>
</head>
<body>
<div class="app">
<header>
  <div class="brand"><div class="logo">S</div><div><h1>STUDY FLOW</h1><p>PERSONAL LEARNING DASHBOARD</p></div></div>
  <div class="header-right"><div class="date-pill" id="todayLabel"></div><button class="btn" id="exportBtn">데이터 백업 ↓</button><button class="btn" id="importBtn">불러오기 ↑</button><input type="file" id="importFile" accept="application/json" hidden></div>
</header>
<section class="hero"><div><div class="eyebrow">YOUR STUDY, YOUR FLOW</div><h2>오늘의 공부를 쌓아가자.</h2><p>작은 기록이 모여 큰 변화를 만듭니다.</p></div><div class="hero-note">기록은 이 브라우저에 자동 저장됩니다.<br>다른 기기와 자동 동기화되지는 않습니다.</div></section>
<section class="grid">
  <div class="card stat"><div class="stat-icon">◷</div><div class="stat-label">오늘 공부 시간</div><div class="stat-value" id="todayHours">0h 00m</div><div class="stat-foot">오늘 완료한 학습 기록 기준</div></div>
  <div class="card stat"><div class="stat-icon">▥</div><div class="stat-label">이번 주 누적</div><div class="stat-value" id="weekHours">0h 00m</div><div class="stat-foot">월요일부터 오늘까지</div></div>
  <div class="card stat"><div class="stat-icon">◎</div><div class="stat-label">이번 주 목표</div><div class="stat-value" id="goalPercent">0%</div><div class="stat-foot" id="goalFoot">목표 40시간</div></div>
  <div class="card stat"><div class="stat-icon">✓</div><div class="stat-label">완료한 진도</div><div class="stat-value" id="doneCount">0개</div><div class="stat-foot">전체 학습 항목 기준</div></div>
  <div class="card wide">
    <div class="card-head"><h3>주간 시간표</h3><button class="mini" id="addEventBtn">＋ 일정 추가</button></div>
    <div class="schedule" id="schedule"></div>
  </div>
  <div class="card side">
    <div class="card-head"><h3>학습 타이머</h3><span class="tag" id="timerStatus">대기 중</span></div>
    <select class="field" id="timerSubject"><option>국어</option><option>수학</option><option>영어</option><option>통합사회</option><option>통합과학</option></select>
    <div class="timer-display" id="timerDisplay">00:00:00</div><div class="timer-sub">시작하면 공부 시간이 자동으로 기록돼요.</div>
    <div class="timer-controls"><button class="btn primary" id="timerStart">시작</button><button class="btn" id="timerPause" disabled>일시정지</button><button class="btn" id="timerFinish" disabled>완료</button></div>
    <div class="muted" style="font-size:10px;text-align:center">타이머가 실행 중인 동안 이 페이지를 열어 두세요.</div>
  </div>
  <div class="card half">
    <div class="card-head"><h3>과목별 진도</h3><button class="mini" id="addTaskBtn">＋ 학습 항목</button></div>
    <div id="subjectsProgress"></div>
  </div>
  <div class="card half">
    <div class="card-head"><h3>최근 7일 학습 시간</h3><span class="tag">시간</span></div>
    <div class="bar-chart" id="weeklyChart"></div>
  </div>
  <div class="card full">
    <div class="card-head"><h3>최근 학습 기록</h3><button class="mini" id="manualLogBtn">＋ 시간 직접 기록</button></div>
    <div class="table-wrap"><table><thead><tr><th>날짜</th><th>과목</th><th>학습 내용</th><th>시간</th><th></th></tr></thead><tbody id="logTable"></tbody></table></div>
  </div>
</section>
<div class="footer">STUDY FLOW · LOCAL FIRST · YOUR DATA STAYS IN THIS BROWSER</div>
</div>

<div class="modal-back" id="modalBack"><div class="modal"><h3 id="modalTitle">항목 추가</h3><div id="modalBody"></div><div class="modal-actions"><button class="btn" id="cancelModal">취소</button><button class="btn primary" id="saveModal">저장</button></div></div></div>
<div class="toast" id="toast"></div>
<script>
const SUBJECTS=['국어','수학','영어','통합사회','통합과학'];
const KEY='study-flow-v1';
const todayISO=()=>{const d=new Date();return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`};
const dateOffset=(n)=>{const d=new Date();d.setDate(d.getDate()+n);return d};
const iso=(d)=>`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
const defaultData=()=>({goal:40,events:[],tasks:SUBJECTS.map(s=>({id:crypto.randomUUID(),subject:s,title:'',done:false})),logs:[]});
let data;try{data=JSON.parse(localStorage.getItem(KEY))||defaultData()}catch{data=defaultData()}
function save(){localStorage.setItem(KEY,JSON.stringify(data));render()}
function minsToText(m){const h=Math.floor(m/60),r=m%60;return `${h}h ${String(r).padStart(2,'0')}m`}
function secToText(s){return [Math.floor(s/3600),Math.floor(s%3600/60),s%60].map(x=>String(x).padStart(2,'0')).join(':')}
function weekStart(){let d=new Date();d.setHours(0,0,0,0);d.setDate(d.getDate()-((d.getDay()+6)%7));return iso(d)}
function sumLogs(start,end){return data.logs.filter(l=>l.date>=start&&l.date<=end).reduce((a,l)=>a+l.minutes,0)}
function toast(t){const el=document.getElementById('toast');el.textContent=t;el.classList.add('show');setTimeout(()=>el.classList.remove('show'),2100)}
function render(){
 const today=todayISO(),start=weekStart(),todayM=sumLogs(today,today),weekM=sumLogs(start,today);
 document.getElementById('todayLabel').textContent=new Date().toLocaleDateString('ko-KR',{year:'numeric',month:'long',day:'numeric',weekday:'long'});
 document.getElementById('todayHours').textContent=minsToText(todayM);document.getElementById('weekHours').textContent=minsToText(weekM);
 document.getElementById('goalPercent').textContent=Math.round(weekM/(data.goal*60)*100)+'%';document.getElementById('goalFoot').textContent=`목표 ${data.goal}시간`;
 document.getElementById('doneCount').textContent=data.tasks.filter(t=>t.done).length+'개';
 const days=Array.from({length:7},(_,i)=>{let d=new Date();d.setDate(d.getDate()-((d.getDay()+6)%7)+i);return d});
 document.getElementById('schedule').innerHTML=days.map(d=>{const ds=iso(d),ev=data.events.filter(e=>e.date===ds).sort((a,b)=>a.time.localeCompare(b.time));return `<div class="day ${ds===today?'today':''}"><div class="day-name">${['일','월','화','수','목','금','토'][d.getDay()]} ${d.getDate()}</div>${ev.length?ev.map(e=>`<div class="event"><small>${e.time}</small>${escapeHTML(e.title)}</div>`).join(''):'<div class="empty">일정 없음</div>'}</div>`}).join('');
 document.getElementById('subjectsProgress').innerHTML=SUBJECTS.map(s=>{const list=data.tasks.filter(t=>t.subject===s),done=list.filter(t=>t.done).length,p=list.length?Math.round(done/list.length*100):0;return `<div class="subject"><div class="subject-top"><strong>${s}</strong><span>${done}/${list.length} 완료 · ${p}%</span></div><div class="progress-track"><div class="progress-fill" style="width:${p}%"></div></div>${list.map(t=>`<div style="display:flex;align-items:center;gap:7px;margin-top:7px;font-size:11px"><input type="checkbox" data-task="${t.id}" ${t.done?'checked':''} style="accent-color:#91aaff"><span style="flex:1;color:${t.done?'#758198':'#dce3f1'};text-decoration:${t.done?'line-through':'none'}">${escapeHTML(t.title||'학습 항목을 추가해 주세요')}</span><button class="mini" data-delete-task="${t.id}">×</button></div>`).join('')}</div>`}).join('');
 const chartDays=Array.from({length:7},(_,i)=>dateOffset(i-6)),vals=chartDays.map(d=>sumLogs(iso(d),iso(d))),max=Math.max(60,...vals);
 document.getElementById('weeklyChart').innerHTML=chartDays.map((d,i)=>`<div class="bar-col"><div class="bar-number">${(vals[i]/60).toFixed(vals[i]%60?1:0)}</div><div class="bar" style="height:${Math.max(2,vals[i]/max*100)}%"></div><div class="bar-label">${['일','월','화','수','목','금','토'][d.getDay()]}</div></div>`).join('');
 const recent=[...data.logs].sort((a,b)=>(b.date+b.id).localeCompare(a.date+a.id)).slice(0,8);
 document.getElementById('logTable').innerHTML=recent.length?recent.map(l=>`<tr><td>${l.date}</td><td><span class="tag">${escapeHTML(l.subject)}</span></td><td>${escapeHTML(l.title||'자율 학습')}</td><td>${l.minutes}분</td><td><button class="mini" data-delete-log="${l.id}">삭제</button></td></tr>`).join(''):`<tr><td colspan="5" class="empty-state">아직 학습 기록이 없어요. 타이머를 시작하거나 직접 기록해 보세요.</td></tr>`;
}
function escapeHTML(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
let modalAction=null;
function openModal(title,fields,action){document.getElementById('modalTitle').textContent=title;document.getElementById('modalBody').innerHTML=fields;modalAction=action;document.getElementById('modalBack').style.display='grid'}
function closeModal(){document.getElementById('modalBack').style.display='none';modalAction=null}
document.getElementById('cancelModal').onclick=closeModal;document.getElementById('saveModal').onclick=()=>{if(modalAction)modalAction();};
document.getElementById('addEventBtn').onclick=()=>openModal('주간 일정 추가',`<label class="muted">날짜</label><input class="field" id="fDate" type="date" value="${todayISO()}"><div class="form-row"><div style="flex:1"><label class="muted">시간</label><input class="field" id="fTime" type="time" value="16:00"></div><div style="flex:2"><label class="muted">일정 이름</label><input class="field" id="fTitle" placeholder="예: 수학 학원"></div></div>`,()=>{const title=document.getElementById('fTitle').value.trim();if(!title)return toast('일정 이름을 입력해 주세요.');data.events.push({id:crypto.randomUUID(),date:document.getElementById('fDate').value,time:document.getElementById('fTime').value,title});closeModal();save();});
document.getElementById('addTaskBtn').onclick=()=>openModal('학습 항목 추가',`<label class="muted">과목</label><select class="field" id="fSubject">${SUBJECTS.map(s=>`<option>${s}</option>`).join('')}</select><label class="muted">교재·강의·학습 내용</label><input class="field" id="fTitle" placeholder="예: 수학 미적분 3강">`,()=>{const title=document.getElementById('fTitle').value.trim();if(!title)return toast('학습 내용을 입력해 주세요.');data.tasks.push({id:crypto.randomUUID(),subject:document.getElementById('fSubject').value,title,done:false});closeModal();save();});
document.getElementById('manualLogBtn').onclick=()=>openModal('학습 시간 직접 기록',`<label class="muted">날짜</label><input class="field" id="fDate" type="date" value="${todayISO()}"><label class="muted">과목</label><select class="field" id="fSubject">${SUBJECTS.map(s=>`<option>${s}</option>`).join('')}</select><label class="muted">학습 내용</label><input class="field" id="fTitle" placeholder="예: 수학 문제 풀이"><label class="muted">공부 시간 (분)</label><input class="field" id="fMinutes" type="number" min="1" max="1440" placeholder="예: 50">`,()=>{const m=Number(document.getElementById('fMinutes').value);if(!Number.isFinite(m)||m<1||m>1440)return toast('1~1440분 사이로 입력해 주세요.');data.logs.push({id:Date.now(),date:document.getElementById('fDate').value,subject:document.getElementById('fSubject').value,title:document.getElementById('fTitle').value.trim(),minutes:m});closeModal();save();});
document.addEventListener('change',e=>{if(e.target.dataset.task){const t=data.tasks.find(x=>x.id===e.target.dataset.task);if(t){t.done=e.target.checked;save()}}});
document.addEventListener('click',e=>{if(e.target.dataset.deleteTask){data.tasks=data.tasks.filter(t=>t.id!==e.target.dataset.deleteTask);save()}if(e.target.dataset.deleteLog){data.logs=data.logs.filter(l=>String(l.id)!==e.target.dataset.deleteLog);save()}});
let timer={running:false,started:0,elapsed:0,subject:'국어',interval:null};
function updateTimer(){const s=timer.elapsed+(timer.running?Math.floor((Date.now()-timer.started)/1000):0);document.getElementById('timerDisplay').textContent=secToText(s)}
function timerButtons(){document.getElementById('timerStart').disabled=timer.running;document.getElementById('timerPause').disabled=!timer.running;document.getElementById('timerFinish').disabled=timer.elapsed===0&&!timer.running;document.getElementById('timerStatus').textContent=timer.running?'측정 중':timer.elapsed?'일시정지':'대기 중'}
document.getElementById('timerStart').onclick=()=>{if(timer.running)return;timer.subject=document.getElementById('timerSubject').value;timer.started=Date.now();timer.running=true;timer.interval=setInterval(updateTimer,500);timerButtons()};
document.getElementById('timerPause').onclick=()=>{timer.elapsed+=Math.floor((Date.now()-timer.started)/1000);timer.running=false;clearInterval(timer.interval);updateTimer();timerButtons()};
document.getElementById('timerFinish').onclick=()=>{if(timer.running){timer.elapsed+=Math.floor((Date.now()-timer.started)/1000);timer.running=false;clearInterval(timer.interval)}const m=Math.floor(timer.elapsed/60);if(m>0){data.logs.push({id:Date.now(),date:todayISO(),subject:timer.subject,title:'타이머 학습',minutes:m});save();toast(`${m}분 학습 기록을 저장했어요.`)}else toast('1분 미만의 기록은 저장하지 않았어요.');timer.elapsed=0;updateTimer();timerButtons()};
document.getElementById('timerSubject').onchange=e=>{if(timer.running){toast('과목 변경은 타이머를 멈춘 뒤 해주세요.');e.target.value=timer.subject}};
document.getElementById('exportBtn').onclick=()=>{const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='study-flow-backup.json';a.click();URL.revokeObjectURL(a.href);toast('백업 파일을 저장했어요.')};
document.getElementById('importBtn').onclick=()=>document.getElementById('importFile').click();
document.getElementById('importFile').onchange=async e=>{const f=e.target.files[0];if(!f)return;try{const v=JSON.parse(await f.text());if(!Array.isArray(v.logs)||!Array.isArray(v.tasks)||!Array.isArray(v.events))throw Error();data=v;save();toast('데이터를 불러왔어요.')}catch{toast('올바른 백업 파일이 아닙니다.')}e.target.value=''};
render();timerButtons();
</script>
</body>
</html>
